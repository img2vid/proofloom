+// 52. Deletion candidates: the query carries one character too many
+// ("faretoa" -> "fareto", "casa" typed as "casaa"). The Norvig deletion index
+// above cannot recover insertions, so test each single-character deletion.
+export function deletionCandidates(word, isKnown) {
+  const out = [];
+  const lower = word.toLowerCase();
+  for (let i = 0; i < lower.length; i++) {
+    const candidate = lower.slice(0, i) + lower.slice(i + 1);
+    if (candidate && isKnown(candidate)) out.push({word: candidate, distance: 1});
+  }
+  return out;
+}
diff --git a/src/core/algorithms/hunspell.js b/src/core/algorithms/hunspell.js
new file mode 100644
index 0000000..940ed4a
--- /dev/null
+++ b/src/core/algorithms/hunspell.js
@@ -0,0 +1,339 @@
+// Bounded Hunspell reader for language packs.
+//
+// Why this exists: nspell expands every affix rule for every dictionary word
+// at parse time (word x flags x combinable cross-products). Morphologically
+// rich tables - Romance verbs with clitic continuation classes, for example -
+// explode into millions of generated forms, freezing the checker worker and
+// pushing the browser's dictionary object past V8's key-enumeration limits
+// ("RangeError: Too many properties to enumerate"). English ships small affix
+// tables and never hit this; real Italian/French/German pairs do.
+//
+// This module never expands. It parses the affix and dictionary files into a
+// compact model (hard-capped), and answers membership queries by applying
+// rules in reverse, bounded per query. Surface forms, continuation chains,
+// and prefix/suffix cross-products all work, for every language, with flat
+// memory and time no matter how rich the table.
+
+const MAX_RULES = 4000;
+const MAX_ENTRIES = 25000;
+const MAX_WORDS = 400000;
+const MAX_QUERY_OPS = 25000;
+const MAX_CHAIN_DEPTH = 3;
+
+const modelCache = new Map();
+
+const contentHash = s => `${s.length}:${s.charCodeAt(0) || 0}:${s.charCodeAt(s.length >> 1) || 0}:${s.charCodeAt(s.length - 1) || 0}`;
+
+// Parse rule codes the way nspell does (FLAG long/num/default).
+function ruleCodes(flags, value) {
+  if (!value) return [];
+  if (flags.FLAG === 'long') {
+    const out = [];
+    for (let i = 0; i < value.length; i += 2) out.push(value.slice(i, i + 2));
+    return out;
+  }
+  return value.split(flags.FLAG === 'num' ? ',' : '');
+}
+
+// Parse an .aff file into {flags, rules, alias} without expanding anything.
+export function parseAffix(aff, caps = {}) {
+  const maxRules = caps.maxRules || MAX_RULES;
+  const maxEntries = caps.maxEntries || MAX_ENTRIES;
+  const flags = Object.create(null);
+  const rules = new Map();
+  const alias = [];
+  let entries = 0;
+  const lines = [];
+  for (const raw of aff.replace(/^\uFEFF/, '').split('\n')) {
+    const line = raw.trim();
+    if (line && line.charCodeAt(0) !== 35) lines.push(line); // '#'
+  }
+  for (let i = 0; i < lines.length; i++) {
+    const parts = lines[i].split(/\s+/);
+    const kind = parts[0];
+    if (kind === 'PFX' || kind === 'SFX') {
+      if (rules.size >= maxRules) throw new Error('hunspell-too-complex');
+      const count = Number(parts[3]);
+      if (!Number.isFinite(count) || count < 0) continue;
+      const rule = {flag: parts[1], type: kind, combineable: parts[2] === 'Y', entries: []};
+      for (let n = 0; n < count && ++i < lines.length; n++) {
+        const f = lines[i].split(/\s+/);
+        const addField = (f[3] || '0').split('/');
+        const entry = {
+          add: addField[0] !== '0' ? addField[0] : '',
+          strip: f[2] && f[2] !== '0' ? f[2] : '',
+          match: null,
+          continuation: ruleCodes(flags, addField[1]),
+        };
+        const condition = f[4];
+        if (condition && condition !== '.') {
+          try { entry.match = kind === 'SFX' ? new RegExp(condition + '$') : new RegExp('^' + condition); } catch { continue; }
+        }
+        rule.entries.push(entry);
+        if (++entries > maxEntries) throw new Error('hunspell-too-complex');
+      }
+      rules.set(rule.flag, rule);
+    } else if (kind === 'AF') {
+      const count = Number(parts[1]);
+      for (let n = 0; n < count && ++i < lines.length; n++) {
+        const f = lines[i].split(/\s+/)[1] || '';
+        alias.push(f.split('/')[0]);
+      }
+    } else if (parts.length >= 2 && /^[A-Z][A-Z0-9]*$/.test(kind)) {
+      flags[kind] = parts[1];
+    }
+  }
+  return {flags, rules, alias};
+}
+
+// Parse a .dic file the way nspell does: escape-aware slashes, '#' handling,
+// tab-comment lines, and AF alias indexes. Returns Map word -> codes array.
+export function parseDictionary(dic, flags, alias, caps = {}) {
+  const maxWords = caps.maxWords || MAX_WORDS;
+  const words = new Map();
+  const addWord = (word, codes) => {
+    const existing = words.get(word);
+    if (existing) { for (const c of codes) if (!existing.includes(c)) existing.push(c); }
+    else if (words.size < maxWords) words.set(word, codes);
+  };
+  const resolve = codes => {
+    if (alias.length && codes.length === 1 && /^\d+$/.test(codes[0])) {
+      return ruleCodes(flags, alias[Number(codes[0]) - 1] || '');
+    }
+    return codes;
+  };
+  const start = dic.indexOf('\n') + 1; // first line is the entry count
+  let last = start, index = dic.indexOf('\n', last);
+  while (index > -1) {
+    if (dic.charCodeAt(last) !== 9) { // tab-comment line
+      const parsed = splitDicLine(dic.slice(last, index));
+      if (parsed) addWord(parsed.word, resolve(ruleCodes(flags, parsed.codes)));
+    }
+    last = index + 1;
+    index = dic.indexOf('\n', last);
+  }
+  const parsed = splitDicLine(dic.slice(last));
+  if (parsed) addWord(parsed.word, resolve(ruleCodes(flags, parsed.codes)));
+  return words;
+}
+
+function splitDicLine(line) {
+  let slash = line.indexOf('/');
+  while (slash > -1 && line.charCodeAt(slash - 1) === 92) { // escaped slash
+    line = line.slice(0, slash - 1) + line.slice(slash);
+    slash = line.indexOf('/', slash);
+  }
+  const hash = line.indexOf('#');
+  let word, codes = '';
+  if (hash > -1) {
+    if (slash > -1 && slash < hash) {
+      word = line.slice(0, slash);
+      const m = /\s/.exec(line.slice(slash + 1));
+      codes = line.slice(slash + 1, m ? m.index + slash + 1 : undefined);
+    } else word = line.slice(0, hash);
+  } else if (slash > -1) {
+    word = line.slice(0, slash);
+    codes = line.slice(slash + 1).trim();
+  } else word = line;
+  word = word.trim();
+  return word ? {word, codes} : null;
+}
+
+// Surface words only, for unsupported pairs (membership without morphology).
+// Mirrors the .dic import format used by the resources module.
+export function surfaceWords(dic, cap = 300000) {
+  const out = [];
+  const lines = dic.split('\n');
+  for (let i = 1; i < lines.length && out.length < cap; i++) {
+    const line = lines[i];
+    if (!line || line.charCodeAt(0) === 9) continue;
+    let word = line;
+    const slash = word.indexOf('/');
+    if (slash > -1) word = word.slice(0, slash);
+    const hash = word.indexOf('#');
+    if (hash > -1) word = word.slice(0, hash);
+    word = word.trim();
+    if (word) out.push(word);
+  }
+  return out;
+}
+
+export class HunspellChecker {
+  constructor(model, language = 'en') {
+    this.language = language;
+    const {flags, rules, words} = model;
+    let maxSuffixAdd = 0, maxPrefixAdd = 0;
+    const bySuffixAdd = new Map(), byPrefixAdd = new Map();
+    for (const rule of rules.values()) {
+      for (const entry of rule.entries) {
+        const bucket = rule.type === 'SFX' ? bySuffixAdd : byPrefixAdd;
+        if (!bucket.has(entry.add)) bucket.set(entry.add, []);
+        bucket.get(entry.add).push({rule, entry});
+        if (rule.type === 'SFX') maxSuffixAdd = Math.max(maxSuffixAdd, entry.add.length);
+        else maxPrefixAdd = Math.max(maxPrefixAdd, entry.add.length);
+      }
+    }
+    this.compiled = {
+      words,
+      bySuffixAdd, byPrefixAdd, maxSuffixAdd, maxPrefixAdd,
+      needAffix: flags.NEEDAFFIX, forbidden: flags.FORBIDDENWORD, keepCase: flags.KEEPCASE,
+    };
+    this.wordCount = words.size;
+    this.ruleCount = rules.size;
+    this.id = `hunspell:${this.wordCount}:${this.ruleCount}`;
+  }
+
+  correct(word) {
+    if (typeof word !== 'string' || !word) return false;
+    const c = this.compiled;
+    if (!c.words.size) return false;
+    let ops = 0;
+    const hasFlag = (candidate, flag) => {
+      if (++ops > MAX_QUERY_OPS) return false;
+      const codes = c.words.get(candidate);
+      return !!codes && codes.includes(flag);
+    };
+    const surface = (candidate, exact) => {
+      const codes = c.words.get(candidate);
+      if (!codes) return false;
+      if (c.needAffix && codes.includes(c.needAffix)) return false;
+      if (c.forbidden && codes.includes(c.forbidden)) return false;
+      if (!exact && c.keepCase && codes.includes(c.keepCase)) return false;
+      return true;
+    };
+    // Reverse one application: word = stem --rule.entry--> word. Returns the
+    // stem, or null when the entry cannot have produced this word. Conditions
+    // are tested against the stem, mirroring nspell's forward `apply`.
+    const reverseApply = (value, rule, entry) => {
+      let stem;
+      if (rule.type === 'SFX') {
+        if (entry.add && !value.endsWith(entry.add)) return null;
+        const head = value.slice(0, value.length - entry.add.length);
+        stem = entry.strip ? head + entry.strip : head;
+        if (entry.match && !entry.match.test(stem)) return null;
+      } else {
+        if (entry.add && !value.startsWith(entry.add)) return null;
+        const tail = value.slice(entry.add.length);
+        stem = entry.strip ? entry.strip + tail : tail;
+        if (entry.match && !entry.match.test(stem)) return null;
+      }
+      return stem === value ? null : stem;
+    };
+    const applicable = value => {
+      const out = [];
+      const sfxMax = Math.min(value.length, c.maxSuffixAdd);
+      for (let take = sfxMax; take >= 0; take--) {
+        const bucket = c.bySuffixAdd.get(take === 0 ? '' : value.slice(value.length - take));
+        if (bucket) for (const item of bucket) if (++ops <= MAX_QUERY_OPS) out.push(item);
+      }
+      const pfxMax = Math.min(value.length, c.maxPrefixAdd);
+      for (let take = pfxMax; take >= 0; take--) {
+        const bucket = c.byPrefixAdd.get(take === 0 ? '' : value.slice(0, take));
+        if (bucket) for (const item of bucket) if (++ops <= MAX_QUERY_OPS) out.push(item);
+      }
+      return out;
+    };
+    // Single and chained derivations. `requiredFlag` is the flag of the rule
+    // applied ABOVE the current node: the entry producing this node must list
+    // it among its continuation classes (Hunspell two-level affix rules).
+    const stripSearch = (value, requiredFlag, depth) => {
+      for (const {rule, entry} of applicable(value)) {
+        if (ops > MAX_QUERY_OPS) return false;
+        if (requiredFlag !== null && !entry.continuation.includes(requiredFlag)) continue;
+        const stem = reverseApply(value, rule, entry);
+        if (stem === null) continue;
+        if (hasFlag(stem, rule.flag)) return true;
+        if (depth < MAX_CHAIN_DEPTH && stripSearch(stem, rule.flag, depth + 1)) return true;
+      }
+      return false;
+    };
+    const derived = value => {
+      for (const {rule, entry} of applicable(value)) {
+        if (ops > MAX_QUERY_OPS) return false;
+        const stem = reverseApply(value, rule, entry);
+        if (stem === null) continue;
+        if (hasFlag(stem, rule.flag)) return true;
+        if (stripSearch(stem, rule.flag, 1)) return true;
+      }
+      return false;
+    };
+    // Cross-product: combineable prefix + combineable suffix applied to one
+    // stem (nspell enumerates both application orders for flagged stems).
+    const crossDerived = value => {
+      for (const sfx of applicable(value)) {
+        if (ops > MAX_QUERY_OPS) return false;
+        if (sfx.rule.type !== 'SFX' || !sfx.rule.combineable) continue;
+        const inner = reverseApply(value, sfx.rule, sfx.entry);
+        if (inner === null) continue;
+        for (const pfx of applicable(inner)) {
+          if (ops > MAX_QUERY_OPS) return false;
+          if (pfx.rule.type !== 'PFX' || !pfx.rule.combineable) continue;
+          const stem = reverseApply(inner, pfx.rule, pfx.entry);
+          if (stem === null) continue;
+          if (sfx.entry.match && !sfx.entry.match.test(inner)) continue; // SFX saw the prefixed stem
+          if (hasFlag(stem, sfx.rule.flag) && hasFlag(stem, pfx.rule.flag)) return true;
+        }
+      }
+      for (const pfx of applicable(value)) {
+        if (ops > MAX_QUERY_OPS) return false;
+        if (pfx.rule.type !== 'PFX' || !pfx.rule.combineable) continue;
+        const inner = reverseApply(value, pfx.rule, pfx.entry);
+        if (inner === null) continue;
+        for (const sfx of applicable(inner)) {
+          if (ops > MAX_QUERY_OPS) return false;
+          if (sfx.rule.type !== 'SFX' || !sfx.rule.combineable) continue;
+          const stem = reverseApply(inner, sfx.rule, sfx.entry);
+          if (stem === null) continue;
+          if (pfx.entry.match && !pfx.entry.match.test(inner)) continue; // PFX saw the suffixed stem
+          if (hasFlag(stem, sfx.rule.flag) && hasFlag(stem, pfx.rule.flag)) return true;
+        }
+      }
+      return false;
+    };
+    const probe = (value, original) => surface(value, value === original) || derived(value) || crossDerived(value);
+    if (probe(word, word)) return true;
+    const lower = word.toLowerCase();
+    if (lower !== word) {
+      if (probe(lower, word)) return true;
+      if (word.toUpperCase() === word) {
+        const sentence = word.charAt(0) + lower.slice(1);
+        if (sentence !== word && surface(sentence, false)) return true;
+      }
+    }
+    return false;
+  }
+}
+
+// Parse (and cache) a pack's Hunspell pair. Returns {parsed, lowerWords}:
+// `parsed` is null when the pair is unsupported (legacy encoding) or exceeds
+// the safety caps; `lowerWords` then holds the surface forms so the engine can
+// fall back to wordlist membership. Checking never breaks either way.
+export function loadHunspellPack(pack, language = 'en', caps = {}) {
+  if (!pack || typeof pack.aff !== 'string' || typeof pack.dic !== 'string' || !pack.dic) return {parsed: null, lowerWords: []};
+  const key = `${pack.id || ''}|${language}|${contentHash(pack.aff)}|${contentHash(pack.dic)}`;
+  const cached = modelCache.get(key);
+  if (cached !== undefined) return cached;
+  let parsed = null;
+  try {
+    if (pack.aff.length > 2 * 1024 * 1024 || pack.dic.length > 12 * 1024 * 1024) throw new Error('hunspell-too-complex');
+    if (!/^SET UTF-8\s*$/mi.test(pack.aff)) throw new Error('hunspell-encoding');
+    const aff = parseAffix(pack.aff, caps);
+    const words = parseDictionary(pack.dic, aff.flags, aff.alias, caps);
+    parsed = {flags: aff.flags, rules: aff.rules, alias: aff.alias, words};
+  } catch {
+    parsed = null;
+  }
+  const lowerWords = [];
+  const seen = new Set();
+  const source = parsed ? parsed.words.keys() : surfaceWords(pack.dic);
+  for (const word of source) {
+    if (lowerWords.length >= 300000) break;
+    if (word.length >= 160) continue;
+    const lw = word.toLocaleLowerCase(language);
+    if (!seen.has(lw)) { seen.add(lw); lowerWords.push(lw); }
+  }
+  const loaded = {parsed, lowerWords};
+  if (modelCache.size > 8) modelCache.delete(modelCache.keys().next().value);
+  modelCache.set(key, loaded);
+  return loaded;
+}
