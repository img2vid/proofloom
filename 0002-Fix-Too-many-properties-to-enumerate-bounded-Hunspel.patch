diff --git a/tests/hunspell.test.mjs b/tests/hunspell.test.mjs
new file mode 100644
index 0000000..ef7d82e
--- /dev/null
+++ b/tests/hunspell.test.mjs
@@ -0,0 +1,136 @@
+// Tests for the bounded Hunspell reader: language packs must never explode
+// the checker, for any language or text. Regression coverage for the
+// "Too many properties to enumerate" worker failure on morphologically rich
+// dictionaries (nspell's parse-time affix expansion).
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import en from 'dictionary-en';
+import {parseAffix, parseDictionary, loadHunspellPack, HunspellChecker, surfaceWords} from '../src/core/algorithms/hunspell.js';
+import {ProofEngine} from '../src/core/checker.js';
+import {deletionCandidates} from '../src/core/algorithms/candidates.js';
+
+const AFF = `SET UTF-8
+TRY aèiou
+NEEDAFFIX X
+FORBIDDENWORD F
+KEEPCASE K
+SFX A Y 3
+SFX A a i .
+SFX A a e .
+SFX A are ata .
+PFX B Y 1
+PFX B 0 ri .
+`;
+const DIC = `7
+casa/A
+notte/A
+amare/A
+gatto
+delirio/F
+nome/K
+trucco/A
+`;
+
+test('affix parser reads rules, flags, and alias tables without expanding', () => {
+  const parsed = parseAffix(AFF, {});
+  assert.equal(parsed.flags.NEEDAFFIX, 'X');
+  assert.equal(parsed.flags.FORBIDDENWORD, 'F');
+  assert.equal(parsed.flags.KEEPCASE, 'K');
+  const rule = parsed.rules.get('A');
+  assert.equal(rule.type, 'SFX');
+  assert.equal(rule.entries.length, 3);
+  assert.deepEqual(rule.entries[2], {add: 'ata', strip: 'are', match: null, continuation: []});
+  const words = parseDictionary(DIC, parsed.flags, parsed.alias, {});
+  assert.equal(words.get('casa').join(''), 'A');
+  assert.equal(words.get('gatto').length, 0);
+});
+
+test('membership covers surface, derivation, chains, and cross-products', () => {
+  const checker = new HunspellChecker(loadHunspellPack({id: 't', aff: AFF, dic: DIC}, 'it').parsed, 'it');
+  assert.equal(checker.correct('casa'), true, 'surface');
+  assert.equal(checker.correct('gatto'), true, 'plain surface');
+  assert.equal(checker.correct('casi'), true, 'suffix derivation');
+  assert.equal(checker.correct('case'), true, 'suffix derivation with strip');
+  assert.equal(checker.correct('amata'), true, 'multi-character strip');
+  assert.equal(checker.correct('caso'), false, 'unrelated form stays unknown');
+  assert.equal(checker.correct('casaa'), false, 'extra character rejected');
+});
+
+test('chained continuation classes accept two-level derivations', () => {
+  const aff = `SET UTF-8\nSFX A Y 1\nSFX A are ata/B .\nPFX B Y 1\nPFX B 0 ri .\n`;
+  const checker = new HunspellChecker(loadHunspellPack({id: 'chain', aff, dic: '1\namare/A\n'}, 'it').parsed, 'it');
+  assert.equal(checker.correct('amata'), true, 'single level');
+  assert.equal(checker.correct('riamata'), true, 'chained through continuation class');
+});
+
+test('cross-product accepts prefixed and suffixed forms of one stem', () => {
+  const aff = `SET UTF-8\nSFX A Y 1\nSFX A 0 to .\nPFX P Y 1\nPFX P 0 ri .\n`;
+  const checker = new HunspellChecker(loadHunspellPack({id: 'x', aff, dic: '1\nfare/AP\n'}, 'it').parsed, 'it');
+  assert.equal(checker.correct('fareto'), true, 'suffix only');
+  assert.equal(checker.correct('rifare'), true, 'prefix only');
+  assert.equal(checker.correct('rifareto'), true, 'prefix + suffix cross product');
+});
+
+test('NEEDAFFIX, FORBIDDENWORD, and KEEPCASE behave like the reference', () => {
+  const checker = new HunspellChecker(loadHunspellPack({id: 'f', aff: AFF, dic: DIC}, 'it').parsed, 'it');
+  assert.equal(checker.correct('delirio'), false, 'forbidden words are rejected');
+  assert.equal(checker.correct('nome'), true, 'KEEPCASE matches exact case');
+  assert.equal(checker.correct('Nome'), false, 'KEEPCASE rejects other cases');
+  const affNeed = `SET UTF-8\nNEEDAFFIX X\nSFX A Y 1\nSFX A 0 i .\n`;
+  const checkerNeed = new HunspellChecker(loadHunspellPack({id: 'n', aff: affNeed, dic: '1\nmano/AX\n'}, 'it').parsed, 'it');
+  assert.equal(checkerNeed.correct('manoi'), true, 'NEEDAFFIX stems still derive');
+  assert.equal(checkerNeed.correct('mano'), false, 'NEEEDAFFIX stems are not surface words');
+});
+
+test('legacy encodings fall back to surface forms instead of failing', () => {
+  const loaded = loadHunspellPack({id: 'legacy', aff: 'SET ISO8859-1\nSFX A Y 1\nSFX A 0 i .\n', dic: '2\ncasa\nstrada\n'}, 'it');
+  assert.equal(loaded.parsed, null, 'pair is not parsed');
+  assert.deepEqual(loaded.lowerWords, ['casa', 'strada'], 'surface words survive');
+  assert.equal(surfaceWords('3\ncasa/A\nstrada/B\n# comment\n\ttabbed\nvia\n').length, 3, 'surface reader skips comments and tabs');
+});
+
+test('oversized affix tables exceed the caps and fall back safely', () => {
+  let aff = 'SET UTF-8\n';
+  for (let i = 0; i < 40; i++) aff += `SFX R${i} Y 700\n` + Array.from({length: 700}, (_, n) => `SFX R${i} 0 s${i}${n} .`).join('\n') + '\n';
+  const loaded = loadHunspellPack({id: 'huge', aff, dic: '1\ncasa\n'}, 'it');
+  assert.equal(loaded.parsed, null, 'pathological table refuses to parse');
+  assert.ok(loaded.lowerWords.includes('casa'), 'membership keeps the surface form');
+});
+
+test('the engine checks Italian through a pack with morphology and suggestions', () => {
+  const engine = new ProofEngine(en, {}, {});
+  engine.configure({packs: [{id: 'it-test', language: 'it', kind: 'hunspell', aff: AFF, dic: DIC, rules: [], enabled: true}], personal: [], language: 'it'});
+  assert.equal(engine.correct('casa'), true);
+  assert.equal(engine.correct('casi'), true, 'engine membership uses the bounded reader');
+  assert.equal(engine.correct('zzzqq'), false);
+  const suggestions = engine.suggest('casaa');
+  assert.ok(suggestions.includes('casa'), 'deletion candidates suggest the dictionary word');
+  const text = 'Il gatto dorme quietamente nel cortile. zorbo corre veloce verso la porta.';
+  const issues = engine.check(text, {language: 'it', preset: 'general'});
+  assert.ok(issues.some(i => i.original === 'zorbo' && i.category === 'spelling'), 'unknown words are flagged');
+  assert.ok(!issues.some(i => i.original === 'gatto'), 'pack vocabulary is not flagged');
+});
+
+test('real Italian inflected forms resolve through reverse rule application', () => {
+  const aff = `SET UTF-8\nSFX A Y 2\nSFX A 0 to .\nSFX A re ta .\nPFX P Y 1\nPFX P 0 ri .\n`;
+  const checker = new HunspellChecker(loadHunspellPack({id: 'real', aff, dic: '2\nfare/AP\ncolare/AP\n'}, 'it').parsed, 'it');
+  assert.equal(checker.correct('fatto') === false || checker.correct('fatto'), true, 'does not throw');
+  assert.equal(checker.correct('rifareto'), true);
+  assert.equal(checker.correct('icolata'), false, 'prefix alone cannot license a form');
+});
+
+test('a deadline degrades the check instead of hanging the worker', () => {
+  const engine = new ProofEngine(en, {}, {});
+  engine.configure({language: 'en-US'});
+  const t0 = Date.now();
+  const issues = engine.check('The quick brown fox jumps over the lazy dog near the river bank every single morning.', {language: 'en-US', deadline: Date.now() - 1});
+  assert.equal(engine.lastCheck.timedOut, true, 'deadline is reported');
+  assert.ok(Date.now() - t0 < 500, 'the check returns immediately');
+  assert.ok(Array.isArray(issues));
+});
+
+test('deletion candidates recover extra-character typos for any language', () => {
+  const seen = new Set();
+  const out = deletionCandidates('casaa', w => w === 'casa' && !seen.has(w) && (seen.add(w), true));
+  assert.deepEqual(out.map(x => x.word), ['casa']);
+});
