From 9f0bb26686a199f180a3527eb9c174e5e0363896 Mon Sep 17 00:00:00 2001
From: Z User <z@container>
Date: Sun, 1 Nov 2026 06:22:13 +0000
Subject: [PATCH] Accept Bengali and Brahmic inflections everywhere; keep
 quick-fix off selections
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Modified Bengali words were still reported as spelling errors. The bn
table carried only a handful of endings, so productive markers never
resolved: genitive ের/য়ের, locative ে, classifier stacks (গুলো/গুলি,
খানা, টা/টি with their case forms), the animate plural রা, and the
person/tense verb endings (েছি/েছিলাম, ছি/চ্ছি, লাম, বে, েন, ুন, ো).
The Bengali spec now covers all of them, chains three deep, and treats
vowel-stem forms (বই -> বইয়ের) directly; typos like মানুসের,
করক্স, and the doubled বইয়েরর stay flagged.

Every other Brahmic script gains the same treatment, and each curated
table doubles as its script's fallback so imported packs in any
neighbouring language get real morphology too: Gujarati's plural sign
was the wrong codepoint (ઓ letter -> ો sign), Tamil now undoes nasal
sandhi and doubled-த் stems (மரம் -> மரங்கள், மரத்தை), Telugu undoes
the retroflex plural (ఇల్లు -> ఇళ్లు), Hindi oblique stems swap back
to -ा (লड़का -> लड़कें), and Gurmukhi, Kannada, Odia, Sinhala, and a
new Malayalam table round out the set. Tokenization keeps ZWJ/ZWNJ
inside Indic words instead of splitting conjuncts in two.

Two further correctness fixes make the whole layer trustworthy for
Indic input: words are compared in NFC (some IMEs emit য় as য + nukta
and ো as ে + া, which previously guaranteed a flag), and the bundled
corpus frequency lists vouch for common roots the LibreOffice wordlists
omit (English keeps its stacked-typo gates and never uses that path).
Suggestion now walks through inflected intermediates so the main root
form leads the list (মানুষ, not মানুষে).

The in-editor quick-fix popover no longer fights text selection: a
click that ends a drag, double-click, or shift-click selection closes
the popover instead of opening one, and any non-collapsed selection in
the editor closes an open popover, so picking corrections and selecting
text stay independent gestures.
---
 src/app.js                      |  15 ++-
 src/core/algorithms/tokenize.js |   6 +-
 src/core/checker.js             |  18 ++-
 src/core/data/inflections.js    | 189 +++++++++++++++++++++++---------
 src/core/morphology.js          |  11 +-
 src/worker.js                   |   2 +-
 tests/morphology.test.mjs       |  76 ++++++++++++-
 7 files changed, 252 insertions(+), 65 deletions(-)

diff --git a/src/app.js b/src/app.js
index 86fc410..b16a940 100644
--- a/src/app.js
+++ b/src/app.js
@@ -485,14 +485,27 @@ $('#menu-button').onclick=()=>document.body.classList.toggle('nav-open');
 dialog.addEventListener('click',ev=>{if(ev.target===dialog){const r=dialog.getBoundingClientRect();if(ev.clientX<r.left||ev.clientX>r.right||ev.clientY<r.top||ev.clientY>r.bottom)dialog.close();}});
 window.addEventListener('hashchange',()=>{void flushSave();render();});window.addEventListener('resize',()=>{resizeEditor();closeQuickFix();});
 // Click-to-correct: a click in the editor that lands on a highlighted word
-// opens the correction popover for that issue.
+// opens the correction popover for that issue. Selecting text (drag,
+// double-click, shift-click) is never a correction request: a live
+// non-collapsed selection only closes the popover instead of opening one,
+// so the popover can no longer steal focus mid-selection and wipe out the
+// text the user just selected.
 document.addEventListener('click',event=>{
   if(state.route!=='editor'||dialog.open)return;
   const ta=event.target.closest('#editor');
   if(!ta)return;
+  if((ta.selectionEnd??0)>(ta.selectionStart??0)){closeQuickFix();return;}
   const issue=findIssueAtOffset(state.issues,ta.selectionStart??0);
   if(issue)openQuickFixFor(issue);else closeQuickFix();
 });
+// Selections made with the keyboard (or programmatically) close the popover
+// as well, so a correction card never sits between the user and the text
+// they are selecting.
+document.addEventListener('selectionchange',event=>{
+  if(state.route!=='editor'||!quickFixOpen())return;
+  const ta=event.target;
+  if(ta&&ta.id==='editor'&&(ta.selectionEnd??0)>(ta.selectionStart??0))closeQuickFix();
+});
 window.addEventListener('beforeunload',event=>{if(!state.storage){event.preventDefault();event.returnValue='';}});
 document.addEventListener('visibilitychange',()=>{if(document.hidden)void flushSave();});
 
diff --git a/src/core/algorithms/tokenize.js b/src/core/algorithms/tokenize.js
index d91ecaf..a01cd9a 100644
--- a/src/core/algorithms/tokenize.js
+++ b/src/core/algorithms/tokenize.js
@@ -1,9 +1,11 @@
 // Text segmentation algorithms: words, sentences, paragraphs with offsets.
 
-// 28. Word tokenization with UTF-16 offsets.
+// 28. Word tokenization with UTF-16 offsets. ZWJ/ZWNJ join conjuncts in
+// Indic scripts (Sinhala මනුෂ්‍ය, Marathi half forms), so they belong
+// inside a word instead of splitting it in two.
 export function tokenizeWords(text) {
   const out = [];
-  const pattern = /[\p{L}\p{M}][\p{L}\p{M}'’-]*/gu;
+  const pattern = /[\p{L}\p{M}][\p{L}\p{M}\u200C\u200D'’-]*/gu;
   for (const m of text.matchAll(pattern)) {
     const word = m[0];
     out.push({ word, lower: word.toLowerCase().replace(/[’]/g, "'"), start: m.index, end: m.index + word.length });
diff --git a/src/core/checker.js b/src/core/checker.js
index ffe1ef0..7707c5d 100644
--- a/src/core/checker.js
+++ b/src/core/checker.js
@@ -83,11 +83,11 @@ export class ProofEngine {
     this.morphology = Morphology.forLanguage(language);
     this.morphCache.clear();
     this.british = /^en-(GB|IN|AU|NZ|IE)/i.test(language);
-    this.personal = new Set(personal.map(x => x.toLocaleLowerCase(language)));
+    this.personal = new Set(personal.map(x => String(x).normalize('NFC').toLocaleLowerCase(language)));
     this.wordlist = new Set();
     this.extraSpells = [];
     for (const p of packs.filter(p => p.enabled && (p.language === language || p.language === language.split('-')[0]))) {
-      for (const word of p.words || []) this.wordlist.add(word.toLocaleLowerCase(language));
+      for (const word of p.words || []) this.wordlist.add(String(word).normalize('NFC').toLocaleLowerCase(language));
       if (p.kind === 'hunspell') try { this.extraSpells.push(new LazyHunspell({aff: p.aff, dic: p.dic}, {locale: language})); } catch { /* surface forms remain available */ }
     }
     this.pluginRules = compilePackRules(packs, language);
@@ -95,9 +95,14 @@ export class ProofEngine {
   }
 
   // A word counts as known when it or any of its inflected forms resolves
-  // to a dictionary, personal-list, or domain entry.
+  // to a dictionary, personal-list, domain, or common-corpus entry.
   knownRoot(stem) {
     if (this.personal?.has(stem) || this.wordlist?.has(stem) || this.domainWords?.has(stem)) return true;
+    // Corpus frequency lists (bundled for most languages) vouch for common
+    // roots the LibreOffice wordlists omit. English is excluded: its rich
+    // dictionaries plus the cvc/strict-es gates must keep stacked typos like
+    // "walkeded" flagged.
+    if (!this.english && this.frequencyRank(stem) > 0) return true;
     if (this.extraSpells.some(s => s.correct(stem))) return true;
     return !!(this.spell?.correct(stem));
   }
@@ -119,6 +124,10 @@ export class ProofEngine {
   }
 
   correct(word) {
+    // Bangla and other Indic scripts reach this place in decomposed form from
+    // some IMEs (য় as য + nukta, ো as ে + া). Compare everything against
+    // the dictionaries' canonical NFC spelling.
+    word = String(word ?? '').normalize('NFC');
     const lower = word.toLocaleLowerCase(this.language);
     if (this.personal?.has(lower) || this.wordlist?.has(lower)) return true;
     if (this.domainWords?.has(lower)) return true;
@@ -130,12 +139,13 @@ export class ProofEngine {
   }
 
   frequencyRank(word) {
-    return this.frequency?.get(word.toLowerCase()) || 0;
+    return this.frequency?.get(String(word).toLowerCase().normalize('NFC')) || 0;
   }
 
   // Upgraded suggestion pipeline: mapping table first, then Hunspell, then
   // candidate-generation models ranked by the weighted scorer.
   suggest(word) {
+    word = String(word ?? '').normalize('NFC');
     const lower = word.toLocaleLowerCase(this.language);
     if (this.cache.has(lower)) return this.cache.get(lower);
     let scored = [];
