pkgname=openvoice
pkgver=1.0.0
pkgrel=1
pkgdesc="Offline-first speech synthesis GUI and command line"
arch=('any')
license=('MIT')
depends=('ffmpeg' 'python>=3.10')
optdepends=('ffmpeg' 'tk: desktop interface' 'espeak-ng: offline voice engine')
source=("openmukti-audiobook-maker-app-${pkgver}.pyz")
sha256sums=('SKIP')
package() {
  install -Dm644 "${srcdir}/openmukti-audiobook-maker-app-${pkgver}.pyz" "${pkgdir}/usr/share/openvoice/openvoice.pyz"
  mkdir -p "${pkgdir}/usr/bin"
  printf '%s\n' '#!/bin/sh' 'exec python3 /usr/share/openvoice/openvoice.pyz "$@"' > "${pkgdir}/usr/bin/openvoice"
  printf '%s\n' '#!/bin/sh' 'exec python3 /usr/share/openvoice/openvoice.pyz gui "$@"' > "${pkgdir}/usr/bin/openvoice-gui"
  chmod 755 "${pkgdir}/usr/bin/openvoice" "${pkgdir}/usr/bin/openvoice-gui"
}
