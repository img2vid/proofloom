(use-modules (guix packages)
             (guix build-system pyproject)
             (guix gexp)
             (guix licenses)
             (gnu packages python)
             (gnu packages python-build)
             (gnu packages audio)
             (gnu packages video))
(package
 (name "openvoice")
 (version "0.4.0")
 (source (local-file "../.." "openvoice-source" #:recursive? #t))
 (build-system pyproject-build-system)
 (native-inputs (list python-setuptools python-wheel))
 (inputs (list python espeak-ng ffmpeg))
 (synopsis "Offline text-to-speech and audiobook video editor")
 (description "Speech synthesis, editor, audio conversion and picture-based audiobook videos.")
 (home-page "https://example.invalid/openvoice")
 (license expat))
